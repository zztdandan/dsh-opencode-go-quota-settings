{
  "name": "dsh-opencode-go-quota-settings",
  "version": "0.5.0",
  "description": "DSH plugin: OpenCode GO quota, model catalog and connection settings — a native dsh-go strip + panel that show the three quota windows on the phone, a fully labeled native settings form, the key reused from the opencode-go model route, official /v1/models metadata, and a same-origin usage proxy plus a /opencode-go-quota command",
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "docs",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencode",
    "opencode-go",
    "usage",
    "quota",
    "settings",
    "plugin",
    "cordis",
    "dsh-go"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.3.0"
  },
  "license": "MIT",
  "repository": "github:zztdandan/dsh-opencode-go-quota-settings",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "validate": "node scripts/validate.mjs"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "OpenCode GO 额度",
      "en": "OpenCode GO quota"
    },
    "icon": "chart",
    "contributes": {
      "composer.strip": [
        {
          "id": "strip",
          "icon": "chart",
          "text": {
            "zh": "OpenCode GO 额度",
            "en": "OpenCode GO quota"
          },
          "panel": "quota"
        }
      ],
      "panels": [
        {
          "id": "quota",
          "title": {
            "zh": "OpenCode GO 额度",
            "en": "OpenCode GO quota"
          },
          "icon": "chart",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  }
}
