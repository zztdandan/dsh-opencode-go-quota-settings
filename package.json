{
  "name": "dsh-opencode-go-quota-settings",
  "version": "0.6.0",
  "description": "DSH plugin: OpenCode GO quota, model catalog and connection settings in one settings page (quota windows, key state, models, all connection fields) — reuses the opencode-go model key, keeps the generated config form off in favour of the page where dsh-go shows it, plus a same-origin usage proxy and a /opencode-go-quota command",
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "docs",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencode",
    "opencode-go",
    "usage",
    "quota",
    "settings",
    "plugin",
    "cordis",
    "dsh-go"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.3.0"
  },
  "license": "MIT",
  "repository": "github:zztdandan/dsh-opencode-go-quota-settings",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "validate": "node scripts/validate.mjs"
  }
}
