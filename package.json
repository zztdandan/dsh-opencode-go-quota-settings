{
  "name": "dsh-opencode-go-quota-settings",
  "version": "0.1.0",
  "description": "DSH plugin: OpenCode GO plan quota in Settings (no sidebar widget) — same-origin usage proxy for the official 5h/weekly/monthly windows plus a /opencode-go-quota command",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "NOTICE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencode",
    "opencode-go",
    "usage",
    "quota",
    "settings",
    "plugin",
    "cordis"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.3.0"
  },
  "license": "MIT",
  "repository": "github:zztdandan/dsh-opencode-go-quota-settings",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
