{
  "name": "dsh-opencode-go-quota-settings",
  "version": "0.3.0",
  "description": "DSH plugin: OpenCode GO quota, model catalog, and connection settings in Settings — reuses the built-in opencode-go model key, with a key field, official /v1/models metadata, and a same-origin usage proxy for the 5h/weekly/monthly windows plus a /opencode-go-quota command",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencode",
    "opencode-go",
    "usage",
    "quota",
    "settings",
    "plugin",
    "cordis"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.3.0"
  },
  "license": "MIT",
  "repository": "github:zztdandan/dsh-opencode-go-quota-settings",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "validate": "node scripts/validate.mjs"
  }
}
